# Showzy - environment template. Copy to `.env` and fill in.
# One file at the repo root serves both web (Vite, envDir: '..') and api (FastAPI).
# Vite only exposes VITE_* vars to the browser, so everything else stays server-side.

# ---------- Frontend-safe (public by design; RLS must protect tables) ----------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=http://localhost:8000

# ---------- Backend only (NEVER prefix with VITE_) ----------
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_ISSUER=
# Direct Postgres connection string (Dashboard > Connect), used for migrations / transactions
DATABASE_URL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

ALLOWED_ORIGINS=http://localhost:5173

# ---------- Demo payment (simulated, no real money) ----------
DEMO_PAYMENT_MODE=true
DEMO_PAYMENT_CHALLENGE_TTL_SECONDS=300
DEMO_PAYMENT_MAX_ATTEMPTS=5

# ---------- Booking rules ----------
HOLD_DURATION_SECONDS=300
MAX_SEATS_PER_ORDER=6

LOG_LEVEL=INFO

# ---------- Added for playbook ----------
FEE_PERCENT=3
MAX_ACTIVE_HOLDS_PER_USER=2
CHALLENGE_PEPPER=
IP_HASH_PEPPER=

# ---------- Local demo accounts (filled in by api/scripts/create_demo_users.py) ----------
# DEMO_ADMIN_EMAIL= / DEMO_ADMIN_PASSWORD=
# DEMO_CUSTOMER_EMAIL= / DEMO_CUSTOMER_PASSWORD=
# DEMO_CUSTOMER2_EMAIL= / DEMO_CUSTOMER2_PASSWORD=
